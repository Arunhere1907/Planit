# PlanIt - GenAI Event Planning Assistant Environment Configuration
# All external keys are optional: PlanIt runs seamlessly out of the box with in-memory seeded dummy data.

# GEMINI_API_KEY: Optional. For live AI planning generation (Gemini 2.5/3.8 Flash).
# If omitted or invalid, PlanIt uses verified deterministic algorithmic baselines.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_MAPS_API_KEY: Optional. For live Google Places (New) vendor discovery.
# If omitted, PlanIt seamlessly queries the rich curated in-memory vendor database.
GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# RESEND_API_KEY: Optional. For sending email digests. Defaults to ConsoleMailer in dev.
RESEND_API_KEY=""

# PORT: Server listening port (default: 3000)
PORT="3000"

# APP_URL: Base URL for canonical self-referential links
APP_URL="http://localhost:3000"
