# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Optional GenAI & External Integrations
# All keys below are OPTIONAL. The app includes intelligent deterministic fallbacks.
# When keys are absent or invalid, the app uses curated seed data and structured algorithms.

# GEMINI_API_KEY: Google Gemini AI for natural language intake, budget generation, timeline planning
# Fallback: Deterministic math engine generates budgets and timelines without AI
GEMINI_API_KEY=

# GOOGLE_MAPS_API_KEY: Google Places API for live vendor discovery
# Fallback: Uses curated vendor dataset from /data/seed/vendors.json
GOOGLE_MAPS_API_KEY=

# RESEND_API_KEY: Email service for sending reminders and notifications
# Fallback: Logs email simulation to console (no actual emails sent)
RESEND_API_KEY=